pkgname=tiny-crow
pkgver=1.8.5
pkgrel=1
pkgdesc="Minimal coding agent TUI, ported to TypeScript"
arch=('any')
license=('GPL-3.0-only')
depends=('nodejs>=24')
makedepends=('npm')

source=(
    "tiny-crow-${pkgver}.tar.gz"
)

sha256sums=('SKIP')

build() {
    cd "tiny-crow-${pkgver}"
    npm install
    npm run typecheck
}

package() {
    cd "tiny-crow-${pkgver}"
    install -dm755 "${pkgdir}/usr/share/tiny-crow"
    cp -r src data package.json package-lock.json node_modules README.md LICENSE "${pkgdir}/usr/share/tiny-crow/"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -dm755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/tiny-crow" <<'EOF'
#!/bin/sh
exec node /usr/share/tiny-crow/src/main.ts "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/tiny-crow"
}
